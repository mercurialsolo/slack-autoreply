# Lives at ~/.slack-autoreply/.env  (README says where each token comes from)
#
# On a StaffAI machine with an Infisical identity, the keys below come from Infisical instead
# (SLACK_APP_TOKEN, SLACK_USER_TOKEN, SLACK_BOT_TOKEN, TYPESAFE_API_KEY, LINEAR_API_KEY), and beat
# the copies here. Anything Infisical lacks falls back to this file.
SOLO_INFISICAL=on                   # off: this machine reads only this file
INFISICAL_ENV=dev
INFISICAL_PATHS=/agents,/shared     # first folder that has a key wins; <project id>:/folder reads another project

# ---- Slack
SLACK_APP_TOKEN=xapp-...        # Basic Information → App-Level Tokens, scope connections:write
SLACK_USER_TOKEN=xoxp-...       # OAuth & Permissions → User OAuth Token  (NOT the xoxb bot token)

# ---- Triage: Jev (TypeSafe AI). Optional — without it, Claude Haiku triages if ANTHROPIC_API_KEY is set,
#      and without either, Claude Code decides the route itself when it handles the message.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
ANTHROPIC_API_KEY=                  # only used for triage fallback; Claude Code itself runs on your login
TRIAGE_FALLBACK_MODEL=claude-haiku-5-5
TRIAGE_MIN_CONFIDENCE=0.6           # below this a "reply" becomes a "hold" and an "ignore" becomes an "ack"
SENSITIVITY_ESCALATE=4              # 1–5; at or above → never auto-send, draft + alert you instead

# The routing gates. These are the values they shipped with, not values chosen against your
# traffic — which is the whole argument of Husain & Saha, "How To Use Decision Models for Evals"
# (hamel.dev, 2026-10-20). `python3 tools/threshold_sweep.py` replays what each one catches and
# releases on messages already scored, with no model calls, and `--gate answerable|scope` does
# the others. It reports; it does not recommend.
TRIAGE_MAX_EXECUTE=0.5              # at or above → escalate: it asks for an action, not an answer.
                                    # The one gate a sweep should not decide for you — it is what
                                    # stops Solo acting. For reference, on 138 scored messages
                                    # 0.50 catches 60 and 0.60 catches 51, and the nine released
                                    # in between are lookups ("any responses?", "can you also
                                    # check <addr>") that an agent could answer.
TRIAGE_MIN_ANSWERABLE=0.5           # below → a reply becomes a hold (only when it needs a lookup)
TRIAGE_MIN_IN_SCOPE=0.5             # below → escalate: not this workspace's work
TRIAGE_SHORT_MESSAGE=30             # at or under this many characters the action score stops
                                    # describing the message — median 0.55 here against 0.36 for
                                    # longer ones ("ty" 0.86, "421452" 0.89). So a message this
                                    # short that the model itself routed to ignore or ack is not
                                    # forced to you. hold and reply are never exempt. 0 turns the
                                    # exemption off.

# ---- How replies go out
# learn = every reply/hold waits for your ✅ until that (route, sender) has earned auto; escalations never auto
# draft = everything waits for ✅      auto = everything goes straight out (escalations still don't)
MODE=learn
REPLY_DELAY_MIN=20                  # seconds; urgent messages use the minimum
REPLY_DELAY_MAX=90
ONLY_WHEN_AWAY=false
REPLY_IN_CHANNELS=mentions          # off | mentions      (1:1 DMs are always on)
                                    # `mentions` also covers unmentioned replies inside a
                                    # thread Solo has already drafted in — the conversation
                                    # is already its own, and people stop re-typing your name.
REPLY_IN_GROUP_DMS=mentions         # off | mentions | all
ALLOW_USERS=                        # IDs or @handles; empty = everyone. BLOCK wins.
BLOCK_USERS=
ALLOW_CHANNELS=                     # IDs or #names
BLOCK_CHANNELS=
QUIET_HOURS=                        # e.g. 23-07
MAX_REPLIES_PER_HOUR_PER_CONVERSATION=6
DISCLOSE_IF_ASKED=true
# How you get told a draft is waiting. Slack will not notify you about your own messages, and
# Solo posts as you, so the self-DM never badges — the ping has to come from outside Slack.
# The summary is appended as one argument. Empty = no ping (drafts still appear in the self-DM).
#   # Optional. A bot token (xoxb-) from the same app, used ONLY to DM you that a draft is waiting.
# Slack never notifies you about your own messages, and Solo posts as you, so the self-DM cannot
# badge — a nudge from the bot is a different identity and notifies normally. The bot never
# replies to anyone; replies still go out on your user token. Add `bot_user` + bot scopes
# chat:write/im:write to the manifest, reinstall, and paste the bot token here.
SLACK_BOT_TOKEN=

NOTIFY_CMD=node-notify blocked
#   NOTIFY_CMD=osascript -e 'display notification "Solo" with title'
NOTIFY_CMD=

ACK_STYLE=reaction                  # reaction | message
ACK_EMOJI=eyes

# Context-backed replies (ones where Claude read your files/accounts) go out automatically only to these
# people, or to people who have earned it. Everyone else gets a draft for ✅.
SHARE_TRUSTED_USERS=

# ---- Learning
TRUST_PROMOTE_N=5                   # outcomes with a sender before a route can go auto for them
TRUST_PROMOTE_SCORE=0.85            # smoothed success rate needed
TRUST_PROMOTE_N_GLOBAL=20           # …or this many across everyone at this score:
TRUST_PROMOTE_SCORE_GLOBAL=0.9
TRUST_DEMOTE_BAD_IN_LAST5=2         # this many bad outcomes in the last 5 → back to draft
OBSERVE_HOURS=4                     # an auto-sent reply with no edit/delete for this long counts as good
DRAFT_EXPIRE_HOURS=24
VOICE_SAMPLES_CAP=600

# ---- Time-bound holds
HOLD_EOD_HOUR=18
HOLD_START_HOUR=10
FOLLOWUP_REMINDER_MINUTES=15

# ---- Dispatch: the daemon hands each message to your logged-in Claude Code
DISPATCH=claude                     # claude = run `claude -p "/slack-autoreply handle …"` per message
                                    # none   = just queue; you drain with /slack-autoreply run (or /loop)
CLAUDE_BIN=claude
CLAUDE_CWD=                         # where to run it; empty = first CONTEXT_DIR (its .mcp.json and CLAUDE.md apply)
CLAUDE_MODEL=                       # empty = your Claude Code default
CLAUDE_MAX_TURNS=25
CLAUDE_TIMEOUT_SECONDS=600
DISPATCH_PARALLEL=2
DISPATCH_USE_API_KEY=false          # false = ANTHROPIC_API_KEY is hidden from Claude Code so it bills your login
HEALTH_PROBE_MINUTES=0              # paid half of the health check: a real one-turn draft, which is the
                                    # only thing that also sees a rate limit. Off by default — one costs
                                    # ~$0.21, so watching an idle night costs more than the night. 360 is
                                    # a sane value if you want it. Being logged out is caught for free
                                    # every tick either way.

REVIEW_NUDGE_AFTER=10               # corrections that can pile up unread before Solo DMs you to run
                                    # `solo review`. Capture is automatic; distilling into VOICE.md and
                                    # rehearsing against it are not, and unread evidence teaches nothing.
                                    # It asks once per VOICE.md revision and never edits the guide itself.
                                    # 0 turns the reminder off.

# Handing a lookup to an agent. Solo proposes `--task "<question>"` when the answer is somewhere it
# cannot reach. What the agent gets is a READ-ONLY brief, and what comes back arrives through
# `say` as a draft that still waits for your ✅ — in every mode below.
DELEGATE_MODE=shadow                # off | shadow | auto
                                    #   shadow — Solo proposes; you hand it over with 🤖 or
                                    #            `solo dispatch <item>`. Nothing runs by itself.
                                    #   auto   — the daemon hands the proposal over as soon as the
                                    #            writer makes it. Worth it when the proposals are
                                    #            right and the taps are not happening: in shadow
                                    #            Solo asked for the same lookup six times in three
                                    #            days and all six sat unread.
DELEGATE_PEER=                      # `claudectl relay peers`
DELEGATE_CWD=                       # the project the agent works in — the one destination Solo has
DELEGATE_ROLE=                      # label on the brief; matches the bound bus role
DELEGATE_REACH=                     # one line, in your words, naming what that agent can actually
                                    # see — "the staffai prod DB, HubSpot, Gmail, RingCentral, FB
                                    # account state". Printed beside the offer, because the writer
                                    # declined it on 24 of 34 chances while being told an agent
                                    # existed and never what it could reach. Empty prints nothing.
DELEGATE_REPEAT_HOURS=6             # one conversation, one open question. A thread with a dispatch
                                    # still out is not asked again inside this window, however many
                                    # times the subject comes up.

# Memory: one Claude session per conversation (DM or thread), resumed across messages, renewed when old or long
SESSION_CONTINUITY=true
SESSION_MAX_AGE_HOURS=1             # match the prompt cache's 1h TTL. A resume replays the whole
                                    # transcript; inside the hour that is cached and costs ~$0.25,
                                    # cold it pays full cache creation and climbs with depth
                                    # ($0.39 at a session's first run, $2.76 by its twelfth).
SESSION_MAX_RUNS=20

# What Claude may read while composing. Read-only, scoped with absolute-path rules. "*" = anywhere (not advised).
CONTEXT_DIRS=~/Projects,~/Documents
CONTEXT_MCP_ALLOW=*                 # which of your `claude mcp list` servers it may use; comma list or *
CONTEXT_MESSAGES=25                 # how much of the thread it sees

LOG_LEVEL=INFO

# Engineering requests (AGENTS.md Phase 9). Every top-level message in ENG_CHANNEL becomes a GitHub
# issue on ENG_REPO labelled ENG_LABEL, answered in the thread by the bot — not in your voice, so
# it never waits for your ✅. scripts/eng_pickup.py (cron, on the node) gives the oldest unclaimed
# issue to Claude Code, which opens a DRAFT PR. Protect the default branch before turning this on.
ENG_CHANNEL=                        # channel ID (C…) or bare name, no '#' — a value starting with '#'
                                    # reads as a comment here, so it would silently turn this off
ENG_REPO=                           # owner/repo, e.g. StaffAI-Inc/staffai
ENG_LABEL=agent                     # with no ENG_ROUTES, every request gets this label; on a node
                                    # running eng_pickup.py, the queue that node takes from
ENG_MATCH=                          # regex a top-level message must start with; ^\*?SR-\d+ for an SR queue
ENG_ROUTES=                         # assignee=label, comma-separated: U0AKNHXJQ73=agent:barada. The first
                                    # @mention in a request is who it is for; only they get it filed, and
                                    # the label routes it to their cluster. Unlisted assignees are skipped.
ENG_SETTLE_MINUTES=15               # pickup waits this long after filing, so thread replies land first
ENG_LINEAR_TEAM=                    # e.g. ENG: the agent opens the Linear issue itself before any code and
                                    # names its branch from it, so Linear's GitHub app attaches the PR
ENG_MCP_CONFIG=                     # default ~/.slack-autoreply/eng-mcp.json, holding the Linear MCP server:
                                    # {"mcpServers":{"linear-server":{"type":"http","url":"https://mcp.linear.app/mcp"}}}
ENG_REPO_DIR=                       # the agent's own clone; default ~/agent-work/<repo>
ENG_MAX_TURNS=150
ENG_TIMEOUT=5400                    # seconds for one issue
