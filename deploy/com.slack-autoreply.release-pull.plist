<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- macOS launchd agent: every 10 minutes, move the node to the newest release tag (deploy/release-pull.sh).
     install-release-timer.sh fills in __HOME__, __REPO__, __PATH__ and loads it. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.slack-autoreply.release-pull</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/deploy/release-pull.sh</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__PATH__</string>
    <key>HOME</key><string>__HOME__</string>
    <key>LANG</key><string>en_US.UTF-8</string>
    <key>SOLO_REPO</key><string>__REPO__</string>
  </dict>
  <key>StartInterval</key><integer>600</integer>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>__HOME__/.slack-autoreply/release-pull.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.slack-autoreply/release-pull.log</string>
</dict>
</plist>
