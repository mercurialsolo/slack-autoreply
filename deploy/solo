#!/usr/bin/env bash
# `solo` — drive Solo from this machine while it runs on another.
#
# Solo's daemon and its state (tokens, VOICE.md, dossiers, outcomes) live on the node.
# That is deliberate: only one machine may hold the Socket Mode connection, because Slack
# load-balances events across connections on the same app. So this is a proxy, not a second
# copy — every command runs against the node's state, and there is one source of truth.
#
#   solo status | drafts | followups | inbox      what is waiting
#   solo pause [--for 2h] | resume                stop and start it, immediately
#   solo approve <item> | drop <item>             same as ✅ / ❌ in Slack
#   solo about @who | history @who | search "…"   memory
#   solo note @who "fact"                         teach it something durable
#   solo logs [-n N] [-f]                         the daemon log
#   solo restart                                  restart the service on the node
#   solo voice                                    print the voice guide as the node has it
#   solo pull                                     bring the wiki's solo/ up to date from the node
#   solo push                                     send wiki edits to the node (live, no restart)
#   solo train [review|setup]                     run the training skill ON the node
#   solo ssh                                      a shell there
#
# Anything not listed is passed straight through to slackctl, so new subcommands work
# without changing this file.
set -euo pipefail

# `mini` resolves through an ssh Match-exec rule that shells out to ping; when ping is blocked
# that rule errors and ssh aborts entirely. `mini-ts` is the direct tailnet entry with no such
# rule, so it keeps working. Override with SOLO_NODE.
NODE="${SOLO_NODE:-mini-ts}"
REMOTE_HOME="${SOLO_REMOTE_HOME:-/Users/baradas}"
CTL="python3 $REMOTE_HOME/.claude/skills/slack-autoreply/scripts/slackctl.py"
STATE="$REMOTE_HOME/.slack-autoreply"
LOCAL_STATE="$HOME/.slack-autoreply"
# Solo's knowledge base (voice + dossiers) lives in the wiki, not the state dir. On the node
# the daemon reads it through symlinks, so an edit here is live on the next message.
WIKI_SOLO="${SOLO_WIKI:-$HOME/Sandbox/business-wiki/solo}"
REMOTE_WIKI="${SOLO_REMOTE_WIKI:-/Users/barada/Sandbox/business-wiki/solo}"

die() { printf '%s\n' "$*" >&2; exit 1; }
on_node() { ssh "$NODE" "$@"; }

case "${1:-status}" in
  logs)
    shift
    # -f follows; default shows the last 40 lines
    if [ "${1:-}" = "-f" ]; then on_node "tail -f $STATE/listen.log"
    else on_node "tail -n ${1:-40} $STATE/listen.log"; fi
    ;;

  restart)
    on_node "launchctl kickstart -k gui/\$(id -u)/com.slack-autoreply" >/dev/null
    sleep 4
    on_node "grep 'listening as' $STATE/listen.log | tail -1"
    ;;

  voice)
    on_node "cat $STATE/VOICE.md"
    ;;

  pull)
    # Solo's knowledge base lives in the wiki; on the node the daemon reads it through symlinks.
    # Pull brings back what Solo has learned (it appends to people/ as it works).
    [ -d "$WIKI_SOLO" ] || die "no wiki at $WIKI_SOLO — set SOLO_WIKI"
    rsync -a "$NODE:$REMOTE_WIKI/" "$WIKI_SOLO/"
    echo "pulled into $WIKI_SOLO — voice.md ($(grep -c . "$WIKI_SOLO/voice.md") lines), $(ls -1 "$WIKI_SOLO/people" | wc -l | tr -d ' ') dossiers"
    git -C "$(dirname "$WIKI_SOLO")" status --short -- "$(basename "$WIKI_SOLO")" | head -10
    ;;

  push)
    [ -f "$WIKI_SOLO/voice.md" ] || die "no $WIKI_SOLO/voice.md — run: solo pull"
    # Never push .env; tokens are the node's business. voice.md is read per message,
    # so this takes effect on the next DM without restarting anything.
    rsync -a "$WIKI_SOLO/" "$NODE:$REMOTE_WIKI/"
    echo "pushed $WIKI_SOLO → $NODE — live on the next message, no restart"
    ;;

  train)
    # Training must run where the state is, or the node and this machine diverge.
    mode="${2:-review}"
    case "$mode" in review|setup|status|run) ;; *) die "solo train [review|setup|run|status]";; esac
    echo "running /slack-autoreply $mode on $NODE (this is interactive — answer in place)"
    ssh -t "$NODE" "cd /Users/barada/Sandbox && claude \"/slack-autoreply $mode\""
    ;;

  ssh)
    shift; ssh -t "$NODE" "${@:-bash -l}"
    ;;

  -h|--help|help)
    sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'
    ;;

  *)
    # Everything else is a slackctl subcommand, run against the node's state.
    on_node "$CTL $(printf '%q ' "$@")"
    ;;
esac
